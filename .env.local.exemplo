# Copie para .env.local e preencha. NUNCA commite o .env.local.
#
# Atualizado na Fase 14/2 — a versão anterior deste arquivo listava
# variáveis de uma arquitetura baseada em Supabase que foi abandonada
# (NEXT_PUBLIC_SUPABASE_*, CHAVE_CRIPTOGRAFIA, EMAIL_AUTORIZADO). O Jarvis
# hoje usa SQLite local (dados/jarvis.db, fora do git) + um token único
# (JARVIS_TOKEN) — nenhuma dessas variáveis antigas é lida por nenhum
# código atual (confirmado por busca no repositório inteiro).

# ── Núcleo (sem isto, o chat não funciona) ──────────────────────────────
# console.anthropic.com → API Keys
ANTHROPIC_API_KEY=

# ── Segurança ────────────────────────────────────────────────────────
# Token único do Jarvis — protege toda a API (/api/*) e é a SENHA de login
# do navegador em produção (Fase 15). Sem isto, roda "aberto" em modo local
# (aviso único no log, nunca silencioso) — ANTES de publicar na internet,
# configure isto. Gere com:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JARVIS_TOKEN=

# Segredo do webhook do WhatsApp (Fase 16) — vai na URL configurada no
# Evolution API (?segredo=...), nunca num header (Evolution nem sempre
# suporta header customizado). Sem isto, o webhook aceita qualquer
# chamador (modo local, aviso único). Mesmo comando de geração acima.
WHATSAPP_WEBHOOK_SEGREDO=

# ── Modelo — fallback opcional ──────────────────────────────────────────
# platform.openai.com/api-keys — sem isto, o Router usa só Anthropic
# (funciona sozinho; a chave só amplia fallback entre provedores).
OPENAI_API_KEY=

# Terceiro provedor — tem tier GRATUITO de verdade (Fase 17). aistudio.google.com/apikey
GOOGLE_GEMINI_API_KEY=

# ── Descoberta de negócio (opcional) ────────────────────────────────────
# Sem isto, descoberta de negócio novo fica REQUER_CREDENCIAL (honesto: o
# Jarvis diz que não tem, nunca inventa prospect). console.cloud.google.com
# → ative "Places API (New)", billing habilitado.
GOOGLE_PLACES_API_KEY=

# Pesquisa web genérica (opcional). serpapi.com
SERPAPI_KEY=

# ── Google OAuth — Gmail + Calendar (opcional, Fase 14/2) ───────────────
# console.cloud.google.com → APIs & Services → Credentials → OAuth client
# ID (Web application). Redirect URI a cadastrar lá — a URL REAL onde o
# Jarvis está rodando (em produção, a URL da Railway; em dev local,
# http://localhost:3000):
#   SUA_URL/api/integracoes/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── WhatsApp — Evolution API (opcional) ──────────────────────────────────
# Instância própria (self-hosted) do Evolution API v2 — não é a API oficial
# da Meta. Aponte o webhook da instância para /api/whatsapp/webhook.
EVOLUTION_API_URL=
EVOLUTION_API_KEY=
EVOLUTION_INSTANCIA=jarvis

# ── Instagram — publicação real (opcional, ainda sem código que a use) ──
# developers.facebook.com/apps → Instagram Graph API. A pesquisa pública de
# Instagram (busca de perfil) já funciona SEM nenhuma destas duas.
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_BUSINESS_ID=

# ── Intelligence Engine (opcional) ───────────────────────────────────────
# IDs de canal do YouTube (youtube.com/channel/UC...), separados por
# vírgula — sem chave de API nenhuma, via feed Atom público.
YOUTUBE_CANAIS_ALVO=

# newsapi.org — free tier existe, mas a ingestão real ainda não foi
# implementada (registro de integração já existe, honestamente marcado
# "não implementado" em /api/integracoes até isso mudar).
NEWS_API_KEY=

# ── Google Ads (opcional, ainda sem código que o use) ────────────────────
GOOGLE_ADS_TOKEN=

# ── Meta Marketing API (Fase 27) ──────────────────────────────────────────
# ID do app criado em developers.facebook.com/apps (produto "API de
# Marketing" adicionado). Não é secreto — aparece na própria URL do app.
META_APP_ID=
# Configurações do app → Básico → "Chave secreta do aplicativo". Secreta de
# verdade (nunca vai pro Git, nunca em print sem borrar) — usada só pra
# TROCAR/renovar o token de longa duração antes dele expirar (endpoint
# oauth/access_token, grant_type=fb_exchange_token), nunca pra autenticar
# chamada normal de leitura de campanha/insight.
META_APP_SECRET=
# Token de USUÁRIO de longa duração (~60 dias), gerado via Graph API
# Explorer (permissões ads_read, ads_management, business_management,
# leads_retrieval) e trocado por um de longa duração com META_APP_SECRET.
# Sem código de renovação automática ainda — antes de completar os 60 dias,
# precisa trocar manualmente (ou implementar o refresh automático usando
# META_APP_SECRET acima, próximo passo natural).
META_ADS_TOKEN=

# ── Sincronização do vault Obsidian (opcional, Fases 17/18) ──────────────
# Necessário só em produção remota (Hostinger) — sem isto, o vault fica só
# no servidor. Repositório dedicado: github.com/kauanfsouza19-del/jarvis-obsidian
# (privado, NUNCA o mesmo repo do código). Deploy key própria, com "Allow
# write access" marcado, cadastrada em .../jarvis-obsidian/settings/keys.
# O caminho da chave deve ficar DENTRO do volume persistente (/app/dados/...),
# nunca fora dele — senão some a cada restart do container e o dono do
# arquivo não bate com o usuário não-root que roda o processo (achado real
# da Fase 18).
OBSIDIAN_GIT_REMOTO=git@github.com-jarvis-obsidian:kauanfsouza19-del/jarvis-obsidian.git
OBSIDIAN_GIT_SSH_KEY=/app/dados/.ssh/jarvis_obsidian_deploy
